#! /bin/bash

## Clean generated code
if [ $# == 1 ];
then
  rm k_*.c k_*.h query_context.c CMakeLists.txt 2>/dev/null
  exit
fi

## Code generation for context queries
echo -e "\n#include \"query_context.h\"" > query_context.c
echo -e "#include \"global_types.h\"" >> query_context.c

for i in $(egrep '^\sk_' query_context.h | sed 's/^\s//g' | sed 's/,//g' | awk '{print $1;}')
  do
   echo -e "#include \"$i.h\"" >> query_context.c
  done
 
echo -e "\nuint8_t krk_context_parse(uint8_t *user," >> query_context.c
echo -e "                          uint8_t *context," >> query_context.c
echo -e "                          uint8_t *data," >> query_context.c
echo -e "                          uint16_t sz) {\n" >> query_context.c

for i in $(egrep '^\sk_' query_context.h | sed 's/^\s//g' | sed 's/,//g' | awk '{print $1;}')
  do
   echo -e "    if(strncmp(context, str($i), 8))"  >> query_context.c
   echo -e "    {" >> query_context.c
   echo "       return $i""_f(user, data, sz);" >> query_context.c
   echo -e "    }" >> query_context.c
  done
echo "}" >> query_context.c

## Header files for function definition
for i in $(egrep '^\sk_' query_context.h | sed 's/^\s//g' | sed 's/,//g' | awk '{print $1;}')
  do
   echo -e "\n#include \"global_types.h\"" > $i.h
   echo "uint8_t $i""_f(uint8_t *user, uint8_t *data, uint16_t sz);" >> $i.h
  done

## Source files for function definition
for i in $(egrep '^\sk_' query_context.h | sed 's/^\s//g' | sed 's/,//g' | awk '{print $1;}')
  do
   echo -e "\n#include \"$i.h\"\n" > $i.c
   echo "uint8_t $i""_f(uint8_t *user, uint8_t *data, uint16_t sz) {" >> $i.c

   cat >> $i.c << EOF

    uint8_t *tip;
    uint8_t *end;
    uint8_t *items[200] = {0};
    uint16_t sizes[200] = {0};

    uint16_t count = 0;

    tip = data;
    end = tip;

    while(end < sz)
    {
        if(end + sizeof(uint64_t) -1 < sz)
        {
            if ( ((uint64_t)*end) == k_sep )
            {
                items[count] = (uint8_t*)malloc(end-tip);
                sizes[count] = end-tip;
                memcpy(items[count], tip, end-tip);

                count++;

                end = end+sizeof(uint16_t);
                tip = end;
            }
            else
                end++;
        }
        else
            break;
    }

    if ( count == 0)
        return 1;


    return 0;
EOF

   echo -e "}" >> $i.c
  done

## CMakeLists.txt generation
echo "cmake_minimum_required(VERSION 3.6)" > CMakeLists.txt
echo "project(kraken)" >> CMakeLists.txt

echo -e "\nset(CMAKE_C_FLAGS \"\${CMAKE_C_FLAGS} -std=c11 -w\")" >> CMakeLists.txt

SOURCE="set(SOURCE_FILES "
for i in $(ls *.c *.h)
  do
   SOURCE="$SOURCE $i" 
  done
SOURCE="$SOURCE )"

echo -e "\n$SOURCE" >> CMakeLists.txt

echo 'add_executable(kraken ${SOURCE_FILES})' >> CMakeLists.txt

echo -e "\nif (WIN32)" >> CMakeLists.txt
echo "    target_link_libraries(kraken wsock32 ws2_32)" >> CMakeLists.txt
echo "else()" >> CMakeLists.txt
echo "    target_link_libraries(kraken pthread pthread)" >> CMakeLists.txt
echo "endif (WIN32)" >> CMakeLists.txt


