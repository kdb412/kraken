

# bashrc
alias BKKEY='sudo openssl enc -aes-256-cbc -in /etc/letsencrypt/live/kraken-db.com/fullchain.pem -out cert.`date +%s`'
alias CERTGEN='sudo letsencrypt certonly --standalone -d kraken-db.com'

# vim settings
color murphy
set tabstop =2
set softtabstop =2
set shiftwidth =2
set expandtab
set autoindent

# git settings
[alias]
	  ls = log --color --graph --pretty=format:'%C(white)%h%Creset -%C(red)%d%Creset %s %C(cyan)(%cr) %C(bold red)<%an>%Creset' --abbrev-commit --



